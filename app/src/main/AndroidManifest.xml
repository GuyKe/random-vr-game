<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.HelloMetaQuest">

        <!-- Lets the Meta Quest store/launcher know which headsets this app targets.
             Only affects store listings; harmless for sideloaded builds. -->
        <meta-data
            android:name="com.oculus.supportedDevices"
            android:value="quest2|quest3|quest3s|questpro" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Marks this as launchable from the Quest's "Unknown Sources" library. -->
                <category android:name="com.oculus.intent.category.VR" />
            </intent-filter>
        </activity>
    </application>

</manifest>
